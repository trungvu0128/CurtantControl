<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CurtantControl.ViewModels"
        xmlns:views="using:CurtantControl.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="CurtantControl.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CurtantControl · Photobooth"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        Width="1280" Height="760" MinWidth="800" MinHeight="480">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <views:StartupModeView IsVisible="{Binding IsModeSelectionVisible}" />
        <views:UserPhotoboothView IsVisible="{Binding IsCurtainPhotoboothScreenVisible}" />
        <views:RazrIIView IsVisible="{Binding IsRazrIIScreenVisible}" />
        <views:RazrModelSelectionView IsVisible="{Binding IsModelSelectionOpen}" />
        <views:RazrIISettingsView IsVisible="{Binding IsRazrSettingsOpen}" />
        <views:Razr3SettingsView IsVisible="{Binding IsRazr3SettingsOpen}" />
        <Border IsVisible="{Binding IsCurtainSettingsVisible}">
            <views:CurtainSettingsView DataContext="{Binding CurtainSettings}" />
        </Border>
        <views:PinDialogView IsVisible="{Binding IsPinDialogOpen}" />
        <Border IsVisible="{Binding IsStartupUpdateBannerVisible}" IsHitTestVisible="False"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" Padding="14,8"
                CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="#F2AA7E" BorderThickness="1">
            <TextBlock Text="Checking for updates…" Foreground="{DynamicResource TextBrush}" />
        </Border>
        <Border IsVisible="{Binding HasUpdateNotification}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" Padding="14,8" CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="#F2AA7E" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding UpdateNotification}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <Button IsVisible="{Binding IsDeveloperScreenVisible}" Content="Details" Command="{Binding OpenUpdatesCommand}"/>
                <Button Content="×" Command="{Binding DismissUpdateCommand}" AutomationProperties.Name="Dismiss update notice"/>
            </StackPanel>
        </Border>
        <views:UpdatesView IsVisible="{Binding IsUpdatesOpen}" />
    </Grid>
</Window>
