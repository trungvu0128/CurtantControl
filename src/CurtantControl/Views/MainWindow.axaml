<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CurtantControl.ViewModels"
        xmlns:views="using:CurtantControl.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="CurtantControl.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CurtantControl · Photobooth"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        Width="1280" Height="760" MinWidth="800" MinHeight="480">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <views:StartupModeView IsVisible="{Binding IsModeSelectionVisible}" />
        <views:UserPhotoboothView IsVisible="{Binding IsRazrIScreenVisible}" />
        <views:RazrIIView IsVisible="{Binding IsRazrIIScreenVisible}" />
        <views:RazrModelSelectionView IsVisible="{Binding IsModelSelectionOpen}" />
        <views:RazrIISettingsView IsVisible="{Binding IsRazrSettingsOpen}" />
        <Border IsVisible="{Binding IsCurtainSettingsVisible}">
            <views:CurtainSettingsView DataContext="{Binding CurtainSettings}" />
        </Border>
        <views:PinDialogView IsVisible="{Binding IsPinDialogOpen}" />
    </Grid>
</Window>
