<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CurtantControl.ViewModels" xmlns:views="using:CurtantControl.Views" xmlns:services="using:CurtantControl.Services" x:Class="CurtantControl.Views.RazrIISettingsView" x:DataType="vm:MainViewModel" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<UserControl.Styles><Style Selector="Button"><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24,16" /><Setter Property="FontSize" Value="16" /><Setter Property="MinHeight" Value="56" /></Style><Style Selector="TextBox.basic"><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Height" Value="52" /></Style><Style Selector="NumericUpDown"><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style Selector="NumericUpDown.basic"><Setter Property="Height" Value="52" /></Style><Style Selector="NumericUpDown /template/ TextBox"><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style></UserControl.Styles>
<Viewbox Stretch="Uniform"><Grid Width="1200" Height="900" Margin="32" RowDefinitions="80,*,80" RowSpacing="24">
<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                <views:RazrBadge Text="CAMERA RAZR II" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <views:BrandLogo Grid.Column="2" Classes="tight" Width="200" Height="54" VerticalAlignment="Center" />
            </Grid>
<Border Grid.Row="1" Width="820" HorizontalAlignment="Center" Background="{DynamicResource PanelBrush}" CornerRadius="24" Padding="24"><ScrollViewer Name="SetupScroll" VerticalAlignment="Center" MaxHeight="590" VerticalContentAlignment="Center"><StackPanel Width="600" HorizontalAlignment="Center" Spacing="16"><TextBlock Text="CAMERA POSITIONS · CHOICE 1 → 2" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" LetterSpacing="1" Margin="0,0,0,12" />
<Grid ColumnDefinitions="340,180" ColumnSpacing="24" HorizontalAlignment="Center"><StackPanel><StackPanel Spacing="6" Margin="0,0,0,12"><TextBlock Text="1 · Choice name" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" /><ComboBox ItemsSource="{Binding CameraPositionChoices}" SelectedItem="{Binding CameraPosition1Choice, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="52" FontSize="20" CornerRadius="12" AutomationProperties.Name="Position1Name"><ComboBox.ItemTemplate><DataTemplate x:DataType="services:CurtainColorPreset"><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"><Border Background="{Binding Color}" Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></StackPanel><StackPanel Grid.Column="1"><StackPanel Spacing="6" Margin="0,0,0,12"><TextBlock Text="Angle 1 (°)" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" /><NumericUpDown Classes="basic" Value="{Binding RazrDraft.Position1Angle, Mode=TwoWay}" Minimum="0" Maximum="360" Increment="1" FormatString="0.###" MinHeight="52" FontSize="20" CornerRadius="12" /></StackPanel></StackPanel></Grid>
<Grid ColumnDefinitions="340,180" ColumnSpacing="24" HorizontalAlignment="Center"><StackPanel><StackPanel Spacing="6" Margin="0,0,0,12"><TextBlock Text="2 · Choice name" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" /><ComboBox ItemsSource="{Binding CameraPositionChoices}" SelectedItem="{Binding CameraPosition2Choice, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="52" FontSize="20" CornerRadius="12" AutomationProperties.Name="Position2Name"><ComboBox.ItemTemplate><DataTemplate x:DataType="services:CurtainColorPreset"><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"><Border Background="{Binding Color}" Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></StackPanel><StackPanel Grid.Column="1"><StackPanel Spacing="6" Margin="0,0,0,12"><TextBlock Text="Angle 2 (°)" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" /><NumericUpDown Classes="basic" Value="{Binding RazrDraft.Position2Angle, Mode=TwoWay}" Minimum="0" Maximum="360" Increment="1" FormatString="0.###" MinHeight="52" FontSize="20" CornerRadius="12" /></StackPanel></StackPanel></Grid>
<StackPanel Width="180" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,12"><TextBlock Text="Wait time (seconds)" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" /><NumericUpDown Classes="basic" Value="{Binding RazrDraft.SettleSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="1" FormatString="0.###" MinHeight="52" FontSize="20" CornerRadius="12" /></StackPanel>
<Expander Header="Advanced control setup" IsVisible="{Binding CanConfigureRazr}" IsExpanded="False" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBlock Text="Control mode" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
<ComboBox ItemsSource="{Binding ControlModeChoices}" SelectedItem="{Binding SelectedControlMode, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="52" AutomationProperties.Name="RazrIIControlMode"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MainViewModel+ControlModeChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<TextBlock Text="{Binding RazrRelaySummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
<TextBlock Text="MOTOR CONTROL" FontSize="18" FontWeight="Bold" Margin="0,20,0,8" />
<CheckBox Content="Simulate motor" IsChecked="{Binding RazrDraft.SimulateMotor, Mode=TwoWay}" />
<CheckBox Content="I have checked motor wiring and travel limits" IsChecked="{Binding RazrDraft.CalibrationConfirmed, Mode=TwoWay}" />
<Grid ColumnDefinitions="*,240" ColumnSpacing="16"><TextBlock Text="Minimum permitted angle" VerticalAlignment="Center" TextWrapping="Wrap" /><NumericUpDown Grid.Column="1" Value="{Binding RazrDraft.MinimumAngle, Mode=TwoWay}" Minimum="0" Maximum="360" Increment="1" FormatString="0.###" /></Grid>
<Grid ColumnDefinitions="*,240" ColumnSpacing="16"><TextBlock Text="Maximum permitted angle" VerticalAlignment="Center" TextWrapping="Wrap" /><NumericUpDown Grid.Column="1" Value="{Binding RazrDraft.MaximumAngle, Mode=TwoWay}" Minimum="0" Maximum="360" Increment="1" FormatString="0.###" /></Grid>
<TextBlock Text="Stop the old Python controllers before enabling real outputs. GPIO2/3 belong to I2C. Commands use the configured wait time without checking feedback. App exit does not remove the DAC target or cut motor power." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12" />
</StackPanel></Expander>

</StackPanel></ScrollViewer></Border>
<Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16"><StackPanel VerticalAlignment="Center" Spacing="8" Margin="0,0,24,0"><TextBlock Text="{Binding RazrNotice}" Foreground="{DynamicResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap" /><TextBlock Text="Save applies camera settings. Camera will not move." Foreground="{DynamicResource MutedBrush}" FontSize="14" /></StackPanel><Button Grid.Column="1" Command="{Binding CancelRazrSettingsCommand}" Content="Cancel" VerticalAlignment="Center" /><Button Grid.Column="2" Command="{Binding SaveRazrSettingsCommand}" Content="Save" Background="#F2AA7E" Foreground="#19191F" VerticalAlignment="Center" MinWidth="170" /></Grid>
</Grid></Viewbox></UserControl>
