<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CurtantControl.Views.RazrBadge" x:Name="Badge" Width="280" Height="76" IsHitTestVisible="False">
<Border CornerRadius="18" BorderBrush="#262626" BorderThickness="2" Padding="3" BoxShadow="0 4 6 0 #90000000">
<Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#E2E2E2" Offset="0" /><GradientStop Color="#828282" Offset="0.45" /><GradientStop Color="#414141" Offset="0.55" /><GradientStop Color="#B8B8B8" Offset="1" /></LinearGradientBrush></Border.Background>
<Border CornerRadius="14" BorderBrush="#C1C1C1" BorderThickness="1" Padding="4"><Border Background="#373737" CornerRadius="11" Padding="2"><Border CornerRadius="9" BorderBrush="#989898" BorderThickness="1" Padding="10,0">
<Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#9C9C99" Offset="0" /><GradientStop Color="#747470" Offset="0.18" /><GradientStop Color="#62625F" Offset="0.8" /><GradientStop Color="#90908C" Offset="1" /></LinearGradientBrush></Border.Background>
<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
<Border Width="44" Height="44" CornerRadius="22" BorderBrush="#B77951" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#E9AF83" Offset="0" /><GradientStop Color="#CB835C" Offset="1" /></LinearGradientBrush></Border.Background>
<Viewbox Width="30" Height="30"><Canvas Width="32" Height="32"><Path Data="M 5,9 L 10,9 L 12,5 L 20,5 L 22,9 L 27,9 Q 30,9 30,12 L 30,25 Q 30,28 27,28 L 5,28 Q 2,28 2,25 L 2,12 Q 2,9 5,9 Z" Stroke="#563C2E" StrokeThickness="1.8" /><Ellipse Canvas.Left="10" Canvas.Top="12" Width="12" Height="12" Stroke="#563C2E" StrokeThickness="1.8" /><Ellipse Canvas.Left="24" Canvas.Top="12" Width="2" Height="2" Fill="#563C2E" /></Canvas></Viewbox></Border>
<TextBlock Text="{Binding Text, ElementName=Badge}" x:CompileBindings="False" FontSize="18" FontWeight="Bold" Foreground="#F0F0EB" VerticalAlignment="Center" />
</StackPanel></Border></Border></Border></Border></UserControl>