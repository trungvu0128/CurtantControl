<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CurtantControl.ViewModels" xmlns:views="using:CurtantControl.Views"
             xmlns:services="using:CurtantControl.Services" x:Class="CurtantControl.Views.Razr3SettingsView" x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="ColorChoice" x:DataType="services:CurtainColorPreset">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="{Binding Color}" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ComboBox.colorChoice">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="ItemTemplate" Value="{StaticResource ColorChoice}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FormatString" Value="0.###" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </UserControl.Styles>
    <Viewbox Stretch="Uniform">
        <Grid Width="1120" Height="550" Margin="28" RowDefinitions="58,*,56" RowSpacing="18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <views:RazrBadge Text="CAMERA RAZR 3" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Settings" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <views:BrandLogo Grid.Column="2" Classes="tight" Width="148" Height="48" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="24">
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="26">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Backdrops" FontSize="24" FontWeight="SemiBold" />
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="160,*" RowSpacing="13" ColumnSpacing="16">
                            <TextBlock Text="Fixed backdrop" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Classes="colorChoice" ItemsSource="{Binding Razr3Colors}" SelectedItem="{Binding Razr3FixedColor, Mode=TwoWay}" AutomationProperties.Name="Fixed backdrop color" />
                            <TextBlock Grid.Row="1" Text="Curtain 1" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Classes="colorChoice" ItemsSource="{Binding Razr3Colors}" SelectedItem="{Binding Razr3M1Color, Mode=TwoWay}" AutomationProperties.Name="M1 color" />
                            <TextBlock Grid.Row="2" Text="Curtain 2" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Classes="colorChoice" ItemsSource="{Binding Razr3Colors}" SelectedItem="{Binding Razr3M2Color, Mode=TwoWay}" AutomationProperties.Name="M2 color" />
                            <TextBlock Grid.Row="3" Text="Curtain 3" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Classes="colorChoice" ItemsSource="{Binding Razr3Colors}" SelectedItem="{Binding Razr3M3Color, Mode=TwoWay}" AutomationProperties.Name="M3 color" />
                            <TextBlock Grid.Row="4" Text="Curtain 4" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Classes="colorChoice" ItemsSource="{Binding Razr3Colors}" SelectedItem="{Binding Razr3M4Color, Mode=TwoWay}" AutomationProperties.Name="M4 color" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="26">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Camera rotation" FontSize="24" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,168" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="13">
                            <TextBlock Text="Outside angle (°)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Razr3Draft.OutsideAngle, Mode=TwoWay}" Minimum="0" Maximum="360" AutomationProperties.Name="Outside angle" />
                            <TextBlock Grid.Row="1" Text="Room 1 angle (°)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Razr3Draft.RoomAngle, Mode=TwoWay}" Minimum="0" Maximum="360" AutomationProperties.Name="Room 1 angle" />
                            <TextBlock Grid.Row="2" Text="Settling time (seconds)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Razr3Draft.SettleSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.5" AutomationProperties.Name="Settling time" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <CheckBox x:Name="Razr3Simulation" Content="Simulate motor and curtains" IsChecked="{Binding Razr3Draft.Simulate, Mode=TwoWay}" />
                            <CheckBox x:Name="Razr3CalibrationConfirmation" Content="I verified the angles, timing and wiring at the booth"
                                      IsVisible="{Binding !#Razr3Simulation.IsChecked}" IsChecked="{Binding Razr3Draft.CalibrationConfirmed, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding RazrNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Back" Command="{Binding CancelRazrSettingsCommand}" Padding="28,14" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Save" Command="{Binding SaveRazr3SettingsCommand}" Background="#63CCE1" Foreground="#112733" Padding="40,14" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
